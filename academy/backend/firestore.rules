rules_version = '2';

// AI Kids Lab Academy — Firestore security rules.
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Before publishing, put your teacher/admin Google account(s) in ADMINS below.
// Admins sign in to teacher.html with "Sign in with Google" and can see every
// student, download CSVs, and manage the allowlist.

service cloud.firestore {
  match /databases/{database}/documents {

    function ADMINS() { return ['your-admin-email@gmail.com']; }

    function signedIn() { return request.auth != null && request.auth.token.email is string; }
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && me() in ADMINS();
    }
    function allowlistOn() {
      return exists(/databases/$(database)/documents/config/access)
        && get(/databases/$(database)/documents/config/access).data.mode == 'allowlist';
    }
    function allowed(email) {
      return !allowlistOn() || exists(/databases/$(database)/documents/allowlist/$(email));
    }
    function owner(email) { return signedIn() && me() == email; }
    function str(v, n) { return v is string && v.size() <= n; }

    // Settings: {mode: 'open' | 'allowlist'}. Anyone may read it (the sign-in page checks it).
    match /config/{doc} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // One document per allowed email (document ID = the email in lowercase).
    match /allowlist/{email} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Lets the sign-in page greet a returning learner by name. Readable only by exact email.
    match /directory/{email} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if owner(email) && allowed(email)
        && request.resource.data.keys().hasOnly(['name', 'at']) && str(request.resource.data.name, 60);
      allow delete: if isAdmin();
    }

    // Profile + progress summary (what the teacher page shows).
    match /students/{email} {
      allow get: if (owner(email) && allowed(email)) || isAdmin();
      allow list: if isAdmin();
      allow create: if owner(email) && allowed(email)
        && request.resource.data.email == email
        && str(request.resource.data.name, 60) && request.resource.data.name.size() >= 2
        && str(request.resource.data.school, 80) && str(request.resource.data.section, 20);
      allow update: if owner(email) && allowed(email)
        && request.resource.data.email == email
        && request.resource.data.created == resource.data.created
        && str(request.resource.data.name, 60) && str(request.resource.data.school, 80) && str(request.resource.data.section, 20);
      allow delete: if isAdmin();
    }

    // Full saved progress, as one JSON string.
    match /state/{email} {
      allow get: if (owner(email) && allowed(email)) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if owner(email) && allowed(email)
        && request.resource.data.json is string && request.resource.data.json.size() < 1000000;
      allow delete: if isAdmin();
    }

    // Certificates: anyone can check one by ID (verify page); learners create their own.
    match /certs/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn() && id.matches('AIKL-[A-Z0-9]{8}')
        && request.resource.data.email == me() && str(request.resource.data.title, 140);
      allow update, delete: if isAdmin();
    }

    // Sign-up / sign-in log.
    match /logins/{id} {
      allow create: if signedIn() && request.resource.data.email == me()
        && request.resource.data.keys().hasOnly(['email', 'name', 'event', 'at']);
      allow read, delete: if isAdmin();
    }
  }
}
